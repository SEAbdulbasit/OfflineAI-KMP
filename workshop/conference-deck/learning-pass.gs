function learningPass(){
const p=SlidesApp.getActivePresentation(); if(p.getId()!=='13DefuAK4TPqDlWmC3ih0u-h6dqDOJkHpasNjHoWt0w4')throw Error('Wrong deck');
const old=p.getSlides();if(old.length!==20)throw Error('Expected 20 slides');const out=[];
function notes(s,t){s.getNotesPage().getSpeakerNotesShape().getText().setText(t);return s;}
function keep(i){const s=p.appendSlide(old[i]);out.push(s);return s;}
function bullet(title,body,n){const s=p.appendSlide(old[2]);const sh=s.getShapes().sort((a,b)=>a.getTop()-b.getTop());sh[0].getText().setText(title);sh[1].getText().setText(body);sh[1].getText().getTextStyle().setFontFamily('Arial').setFontSize(18).setBold(false);out.push(s);return notes(s,n);}
function code(title,body,n,size=17){const s=p.appendSlide(old[10]);const sh=s.getShapes();const titleShape=sh.find(a=>a.getText().asString().includes('Shared Inference'));const codeShape=sh.find(a=>a.getText().asString().includes('expect class'));titleShape.getText().setText(title);codeShape.getText().setText(body);codeShape.getText().getTextStyle().setFontFamily('Roboto Mono').setFontSize(size).setBold(false);out.push(s);return notes(s,n);}
for(let i=0;i<7;i++)keep(i);
bullet('Choose the Behavior','General text model → text tasks + prompted tool proposals\nFunctionGemma 270M → specialized function-call behavior\nSetup changes → model artifact, chat template, tool format\nJudge correct calls and abstention—not parameter count','60 sec. This repository currently uses general-model prompting on BOTH platforms. FunctionGemma is a different integration: use its documented declaration/call tokens and compatible runtime artifact, evaluate your tool set, and fine-tune when needed; replacing the file alone does not adapt our custom <<JSON>> parser. Sources: https://ai.google.dev/gemma/docs/functiongemma/formatting-and-best-practices and https://ai.google.dev/gemma/docs/mobile-actions');
keep(8);keep(9);keep(11);
code('1. Instruct the Model','To use a tool, reply with ONLY:\n<<{"tool":"TOOL_NAME","arguments":{...}}>>\nQ: Turn on flashlight\nA: <<{"tool":"toggle_torch","arguments":{"enable":true}}>>\nIf no tool needed, answer normally.','60 sec. Exact selected lines from commonMain/tools/ToolPrompt.kt buildSystemPrompt; tool descriptions and OFF example omitted from this excerpt. The variable is called systemPrompt, but this integration prepends instructions to the input; it does not establish a separate privileged system role. Same path on Android and iOS.');
code('2. Receive a Proposal','<<{"tool":"toggle_torch",\n  "arguments":{"enable":true}}>>','30 sec. EXPECTED EXAMPLE, not captured model output. The request is “Turn on flashlight”; output is still text. A syntactically correct call can still be wrong for the user’s intent.',20);
code('3. Parse Completed Output','val toolCall = extractToolCall(fullResponse)\nemit(GenerateResponseResult.Complete(fullResponse, toolCall))','45 sec. Exact lines from commonMain/domain/usecase/GenerateResponseUseCase.kt after streaming completes. ToolPrompt.kt accepts delimiters, raw JSON and recovery paths: this is permissive parsing, not schema-constrained decoding. ChatViewModel dispatches non-null toolCall to ExecuteToolUseCase; ToolRegistry rejects unknown names.',16);
code('4. Validate Before Execution','val value = arguments["enable"] as? JsonPrimitive\nval enable = value?.takeUnless { it.isString }?.booleanOrNull\nif (arguments.keys != setOf("enable") || enable == null) {\n    return ToolResult(spec.name,\n        "Invalid flashlight request. No action was taken.")\n}','60 sec. Condensed from ToggleTorchTool.execute in commonMain/tools/Tooling.kt; only the error-message wording is shortened here. Requires a real JSON Boolean and exactly one argument. A valid call for the wrong intent still passes; evaluate intent separately.',15);
code('5. Android Executes','cameraManager.setTorchMode(cameraId, enable)\ntrue','30 sec. Exact success-path excerpt from androidMain/tools/AppActionsProvider.android.kt. Surrounding code selects a flash-capable camera (preferring rear), checks API level and returns false on failure. This Boolean means native API acceptance, not proof of visible light.',20);
code('6. iOS Executes','try {\n    device.setTorchMode(mode)\n    true\n} finally {\n    device.unlockForConfiguration()\n}','45 sec. Exact excerpt from iosMain/tools/AppActionsProvider.ios.kt. Before this block: find AVCaptureDevice, check hasTorch/isTorchAvailable/isTorchModeSupported and successfully lockForConfiguration. Mode comes from enable. LiteRT-LM Swift maturity and Apple Foundation Models are separate runtime choices; this project shares prompting with Android.',15);
code('Failure: Wrong JSON Type','{"enable":"true"}   // string, not Boolean\n\n// Handler test: malformedArgumentsNeverReachHardware\nassertEquals(0, calls)','60 sec. Application validation test, not observed model failure. Existing ToggleTorchToolTest injects a fake platform and checks eight malformed argument objects, including quoted booleans and extra fields. Targeted Android unit tests passed in this review. No hardware call occurs. The assertion shown is real test code; JSON above is a labelled input example.',18);
bullet('Report the Device Result','Model proposal → toggle_torch {enable:true}\nValid arguments → native adapter executes\nAccepted / unavailable → app displays the result\nNo second model turn is required here','30 sec. ChatViewModel.handleToolCall displays “Model proposal” and “Device result” separately. ExecuteToolUseCase returns the handler result directly; this implementation does not ask the model to invent a confirmation. Native acceptance still needs physical observation.');
bullet('Demo: Follow One Request','Prepared model → disconnect network\n“Turn on flashlight” → inspect proposal and result\n“Turn off flashlight” → verify the physical light\nUnrelated request → evaluate abstention','90 sec. Do not promise abstention: it must be tested. Use a physical device; a simulator cannot prove torch behavior. Compare exact model/template and recorded outcome. If device setup remains blocked, show the deterministic validation test and clearly label inference as unverified.');
bullet('Device Evidence','iPhone 16 Pro · iOS 26.5\nSigned build → installed successfully\nApp launch → blocked by developer trust\nModel / first response / torch → not measured','30 sec. Actual device build and install verified during this review. Device app initially had no model; iOS then refused launch because signing/profile trust was not accepted. No end-to-end inference or flashlight measurement is claimed. Replace this status with a measured run after device trust and model setup: record model artifact, cold/warm state, first non-empty chunk latency, completion time, parsed call, native result and physical observation.');
bullet('Your First Tool','Add copy_text(text) as a ToolHandler\nRegister it in createDefaultToolRegistry()\nImplement Android + iOS AppActionsProvider\nTest valid input, wrong types and native failure','60 sec. Exercise, not an existing feature claim. Entry points: commonMain/tools/Tooling.kt (spec/handler/registry), ToolPrompt.kt (examples), AppActionsProvider.kt (expect), androidMain and iosMain/tools/AppActionsProvider.*.kt (actual). Follow ToggleTorchToolTest with an injected action. Run ./gradlew :composeApp:testDebugUnitTest --tests "*ToggleTorchToolTest" as the baseline, then add your tool test. See workshop/conference-deck/LEARNING_WALKTHROUGH.md for full paths and the evaluation checklist.');
keep(19);old.forEach(s=>s.remove());console.log(JSON.stringify(out.map((s,i)=>({n:i+1,id:s.getObjectId()}))));
}
